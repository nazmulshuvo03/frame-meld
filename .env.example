DATABASE_URL=postgresql+asyncpg://framemeld:framemeld@localhost:5432/framemeld
TEST_DATABASE_URL=postgresql+asyncpg://framemeld:framemeld@localhost:5432/framemeld_test
SESSION_COOKIE_NAME=framemeld_session
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# stub needs no key and never leaves the process -- the test suite always
# uses it regardless of this setting. Set gemini or openrouter to call a
# real model locally.
LLM_PROVIDER=stub
LLM_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DOCS_ENABLED=true
SIGNUP_GRANT_CREDITS=500
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/assets
IMAGE_PROVIDER=stub
IMAGE_MODEL=gemini-2.5-flash-image
MODERATION_ENABLED=false
SPEECH_PROVIDER=stub
SPEECH_MODEL=gemini-2.5-flash-preview-tts
# `stub` (a real WAV, synthesised locally, free) or `lyria` (Google's
# Lyria, ~$0.08 a track, needs GEMINI_API_KEY with billing). Lyria takes no
# duration: it returns a few minutes of MP3 and the composition plays as
# much as the film is long.
MUSIC_PROVIDER=stub
MUSIC_MODEL=lyria-3.5
# Where the Remotion render service answers, and how it reaches this api.
# PUBLIC_API_URL is baked into signed asset URLs, so it must be an address
# the *render service* can resolve.
RENDER_SERVICE_URL=http://localhost:8790
PUBLIC_API_URL=http://localhost:8000
RENDER_TIMEOUT_SECONDS=600
# Signs those URLs so the render service can fetch a still with no session
# cookie. No default: generate your own with
#   python -c "import secrets; print(secrets.token_hex(32))"
ASSET_SIGNING_SECRET=
# `stub` (a real MP4 of a flat colour, free, encoded with the ffmpeg that
# imageio-ffmpeg bundles -- which is why that package is in the [dev] extra)
# or `veo` (Veo 3.1 Lite, $0.05 a second, needs GEMINI_API_KEY with billing).
#
# Veo accepts only 4, 6 or 8 second clips, so a shot of 4.0s or less is
# generated as 4 (~$0.20) and anything above it as 6 (~$0.30). The extra is
# trimmed by the composition. This is the one action expensive enough that a
# 30-shot film's cost is mostly this line.
VIDEO_PROVIDER=stub
VIDEO_MODEL=veo-3.1-lite-generate-preview
# False on http://localhost, where a browser never stores a Secure cookie.
# True is required anywhere with TLS, or the session travels in the clear.
SESSION_COOKIE_SECURE=false
# Which peers uvicorn believes X-Forwarded-For from. Empty means nobody,
# so the login rate limiter keys on the socket address. Behind a proxy this
# must name it, or every request shares one limiter budget.
FORWARDED_ALLOW_IPS=

# ---------------------------------------------------------------------------
# Local development providers (docs/superpowers/local-dev-providers.md)
#
# Free, unlimited, and additive: these are extra values for the *_PROVIDER
# settings above, not replacements. Set them back to stub or gemini and
# nothing else changes. All three need their container running; from inside
# compose the host is host.docker.internal, not localhost.
#
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=local
#   OPENROUTER_BASE_URL=http://model-runner.docker.internal/engines/v1
#   LLM_MODEL=ai/qwen3
#   # Qwen3 is a reasoning model and no OpenAI-compatible server exposes a
#   # parameter to turn that off. Without this it spends 649 tokens and 54
#   # seconds on a one-line answer; with it, 16 tokens and 3 seconds.
#   LLM_SYSTEM_SUFFIX=" /no_think"
#
#   SPEECH_PROVIDER=kokoro
#   KOKORO_BASE_URL=http://host.docker.internal:8880/v1
#
#   IMAGE_PROVIDER=comfyui
#   COMFYUI_BASE_URL=http://host.docker.internal:8188
#   COMFYUI_CHECKPOINT=sd_xl_turbo_1.0_fp16.safetensors
#
# Video stays stub in development: a local clip takes 5-10 minutes against
# the stub's 0.2s, and the free Preview render animates the stills instead.

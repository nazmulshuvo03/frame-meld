DATABASE_URL=postgresql+asyncpg://framemeld:framemeld@localhost:5432/framemeld
TEST_DATABASE_URL=postgresql+asyncpg://framemeld:framemeld@localhost:5432/framemeld_test
SESSION_COOKIE_NAME=framemeld_session
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# stub needs no key and never leaves the process -- the test suite always
# uses it regardless of this setting. Set gemini or openrouter to call a
# real model locally.
LLM_PROVIDER=stub
LLM_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DOCS_ENABLED=true
SIGNUP_GRANT_CREDITS=500
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/assets
IMAGE_PROVIDER=stub
IMAGE_MODEL=gemini-2.5-flash-image
MODERATION_ENABLED=false
SPEECH_PROVIDER=stub
SPEECH_MODEL=gemini-2.5-flash-preview-tts
# No real adapter exists behind this yet (M5-D2) -- `stub` is the only
# name the registry resolves. It emits a real WAV.
MUSIC_PROVIDER=stub
MUSIC_MODEL=lyria-002
# Where the Remotion render service answers, and how it reaches this api.
# PUBLIC_API_URL is baked into signed asset URLs, so it must be an address
# the *render service* can resolve.
RENDER_SERVICE_URL=http://localhost:8790
PUBLIC_API_URL=http://localhost:8000
RENDER_TIMEOUT_SECONDS=600
# Signs those URLs so the render service can fetch a still with no session
# cookie. No default: generate your own with
#   python -c "import secrets; print(secrets.token_hex(32))"
ASSET_SIGNING_SECRET=

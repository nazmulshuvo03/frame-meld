DATABASE_URL=postgresql+asyncpg://framemeld:framemeld@localhost:5432/framemeld
TEST_DATABASE_URL=postgresql+asyncpg://framemeld:framemeld@localhost:5432/framemeld_test
SESSION_COOKIE_NAME=framemeld_session
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# stub needs no key and never leaves the process -- the test suite always
# uses it regardless of this setting. Set gemini or openrouter to call a
# real model locally.
LLM_PROVIDER=stub
LLM_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DOCS_ENABLED=true
SIGNUP_GRANT_CREDITS=500
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./var/assets
